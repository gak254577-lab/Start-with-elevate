rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reviews collection: Publicly readable, anyone can submit reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.clientName != null &&
                      request.resource.data.quote != null;
      allow update, delete: if false;
    }

    // Transformations collection: Publicly readable, anyone can submit transformations
    match /transformations/{transformationId} {
      allow read: if true;
      allow create: if request.resource.data.name != null &&
                      request.resource.data.beforeImage != null &&
                      request.resource.data.afterImage != null;
      allow update, delete: if false;
    }

    // Community gallery photos: Publicly readable, anyone can submit photos
    match /gallery/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.imageUrl != null;
      allow update, delete: if false;
    }
  }
}
